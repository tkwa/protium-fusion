 #include "../coordinates/coordinates.hpp"
 #include "../eos/eos.hpp"
 #include "reconstruction.hpp"
+#include "../eos/general/pulse_eos.hpp"
+
+namespace {
+// Preserve the cell state and conservation; reduce only inadmissible face slopes.
+void PulseAdmissibleFace(AthenaArray<Real> &face,int fi,
+                         const AthenaArray<Real> &center,int ci) {
+  if(pulse::mode==1)return;
+  double fraction=pulse::admissible_face_fraction(face(IDN,fi),face(IPR,fi),center(IDN,ci),center(IPR,ci));
+  if(fraction==1.)return;
+  pulse::face_limited.fetch_add(1,std::memory_order_relaxed);
+  if(center(IDN,ci)>1e-5)pulse::dense_face_limited.fetch_add(1,std::memory_order_relaxed);
+  for(int n=0;n<NHYDRO;++n)face(n,fi)=fraction==0.?center(n,ci):center(n,ci)+fraction*(face(n,fi)-center(n,ci));
+}
+}
+
 
